# Copy this file to .env on each teammate's computer.
# Replace YOUR_URL_ENCODED_PASSWORD and YOUR_TAILSCALE_IP locally.
# Never commit the completed .env file.
DATABASE_URL=postgresql://sidequest_team:YOUR_URL_ENCODED_PASSWORD@YOUR_TAILSCALE_IP:5432/sidequest

# Tailscale traffic to a local PostgreSQL server normally does not use TLS.
# Use "require" instead when connecting to a hosted provider that requires TLS.
DATABASE_SSL=disable
