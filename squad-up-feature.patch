+
+/* Group formation ("Squad up"): additive rules only, reusing the same tokens
+   (colors, radii, spacing) as the rest of hangout.css so this reads as part
+   of the same design system rather than a bolted-on feature. */
+.squad-up {
+  border: 0;
+  border-radius: 20px;
+  background: #775cff;
+  color: #fff;
+  padding: 10px 14px;
+  font-size: 10px;
+  font-weight: 900;
+}
+.squad-up:disabled {
+  background: #d9d4ca;
+  color: #8c8f8b;
+  cursor: not-allowed;
+}
+.squad-list {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 13px;
+}
+.squad-list > b {
+  font-size: 9px;
+  font-weight: 900;
+  letter-spacing: .6px;
+  text-transform: uppercase;
+  color: #777c78;
+}
+.squad-chip {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 2px;
+  border: 1px solid #d9d4ca;
+  border-radius: 14px;
+  background: #fff;
+  padding: 8px 12px;
+}
+.squad-chip span {
+  font-size: 10px;
+  font-weight: 900;
+}
+.squad-chip small {
+  color: #777c78;
+  font-size: 8px;
+}
+.squad-chat .chat-context > span {
+  font-size: 17px;
+  letter-spacing: 2px;
+}
+@media (max-width: 600px) {
+  .friend-action-buttons { flex-wrap: wrap; }
+  .squad-up { width: 100%; }
+}
